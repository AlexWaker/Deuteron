{
  "name": "solgent",
  "version": "0.1.0",
  "description": "CLI-first wallet demo with a bundled native agent",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "solgent": "./dist/index.js",
    "deu": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "native",
    "rust/agent/Cargo.toml",
    "rust/agent/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "node ./scripts/build-native.mjs",
    "deu": "tsx ./src/index.ts",
    "deu:watch": "tsx watch ./src/index.ts",
    "rebuild": "pnpm rebuild bigint-buffer bufferutil utf-8-validate keytar",
    "prepare": "pnpm build && pnpm build:native && node ./scripts/postinstall.mjs",
    "postinstall": "node ./scripts/postinstall.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.0.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@jup-ag/lend": "^0.1.9",
    "@jup-ag/lend-read": "^0.0.12",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bitcoinjs-lib": "^7.0.1",
    "bn.js": "^5.2.3",
    "boxen": "^8.0.1",
    "bs58": "^6.0.0",
    "ecpair": "^3.0.1",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "^6.16.0",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "keytar": "^7.9.0",
    "prompts": "^2.4.2",
    "tiny-secp256k1": "^2.2.4",
    "wif": "^5.0.0"
  }
}